# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<proje-id>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── İsteğe bağlı: PWA (ana ekrana ekle). Boş bırakılırsa varsayılanlar kullanılır. ──
# start_url / scope varsayılanı "./" (göreli): panel hangi alan adında / alt alan adında açılırsa orada çalışır,
# taşırken değiştirmeniz gerekmez. Yalnızca özel bir açılış sayfası isterseniz doldurun (ör. ./dashboard).
# VITE_APP_NAME=AgencyOS
# VITE_APP_SHORT_NAME=AgencyOS
# VITE_PWA_START_URL=./
# VITE_PWA_SCOPE=./
# VITE_THEME_COLOR=#00ADA7
# VITE_BACKGROUND_COLOR=#f8fafc
# Geliştirmede (npm run dev) service worker'ı da denemek için .env.development.local içine:
# VITE_PWA_DEV=true

# İsteğe bağlı: telefon / tarayıcı push bildirimleri (genel VAPID anahtarı; gizli anahtar Supabase Secrets'ta)
# VITE_VAPID_PUBLIC_KEY=
